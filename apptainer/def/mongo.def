Bootstrap: docker
From: mongo:8.2

# 8.2 rather than 8.0: MongoDB 8.0 refuses to start on Linux kernel 6.19 and
# newer (https://jira.mongodb.org/browse/SERVER-121912). 8.0 to 8.2 is a
# supported direct upgrade and 8.2 to 8.0 a supported downgrade, provided
# featureCompatibilityVersion is left at "8.0" until you are ready to give up
# that path.

%runscript
    export MONGO_INITDB_ROOT_USERNAME=${BOOM_DATABASE__USERNAME:-mongoadmin}
    export MONGO_INITDB_ROOT_PASSWORD=${BOOM_DATABASE__PASSWORD:?BOOM_DATABASE__PASSWORD must be set and non-empty}
    exec docker-entrypoint.sh mongod --logpath /log/mongo.log