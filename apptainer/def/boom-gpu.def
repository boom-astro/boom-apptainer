Bootstrap: docker
From: nvidia/cuda:12.8.1-cudnn-devel-ubuntu24.04
Stage: build

%arguments
    BOOM_GIT_SHA=

# The `gpu` feature pulls in villar-pso, whose build script compiles CUDA
# kernels with nvcc, so this stage needs the devel image. The final stage below
# only runs them, so it goes back to the runtime image and the SIF stays small.

%files
    Cargo.toml /app/Cargo.toml
    Cargo.lock /app/Cargo.lock
    build.rs /app/build.rs
    proto /app/proto
    apache-avro-macros /app/apache-avro-macros
    src /app/src

%post
    KAFKA_VERSION=4.3.1
    SCALA_VERSION=2.13
    ONNXRUNTIME_GPU_VERSION=1.24.4
    RUST_VERSION=1.93.1
    export DEBIAN_FRONTEND=noninteractive

    apt-get update && \
    apt-get install -y --no-install-recommends \
      ca-certificates curl bash tar xz-utils \
      gcc g++ libhdf5-dev libclang-dev perl make \
      libsasl2-dev libsasl2-2 libcfitsio-dev pkg-config \
      python3 python3-venv && \
    apt-get autoremove && apt-get clean && rm -rf /var/lib/apt/lists/*

    # Install Rust toolchain
    curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain ${RUST_VERSION}
    export PATH="/root/.cargo/bin:/usr/local/cuda/bin:$PATH"
    export LIBRARY_PATH="/usr/local/cuda/lib64:/usr/local/cuda/targets/x86_64-linux/lib"
    export LD_LIBRARY_PATH="/usr/local/cuda/lib64:/usr/local/cuda/targets/x86_64-linux/lib"

    # Install ONNX Runtime GPU shared libs via pip, then copy them to /opt/ort
    python3 -m venv /opt/ort-py
    /opt/ort-py/bin/pip install --no-cache-dir "onnxruntime-gpu==${ONNXRUNTIME_GPU_VERSION}"
    ORT_CAPI_DIR="$('/opt/ort-py/bin/python' -c 'import pathlib, onnxruntime as ort; print(pathlib.Path(ort.__file__).resolve().parent / "capi")')"
    mkdir -p /opt/ort
    cp "${ORT_CAPI_DIR}/libonnxruntime.so.${ONNXRUNTIME_GPU_VERSION}" /opt/ort/
    cp "${ORT_CAPI_DIR}/libonnxruntime_providers_cuda.so" /opt/ort/
    cp "${ORT_CAPI_DIR}/libonnxruntime_providers_shared.so" /opt/ort/
    cp "${ORT_CAPI_DIR}/libonnxruntime_providers_tensorrt.so" /opt/ort/
    ln -sf /opt/ort/libonnxruntime.so.${ONNXRUNTIME_GPU_VERSION} /opt/ort/libonnxruntime.so
    rm -rf /opt/ort-py

    # Install Kafka CLI tools
    # dlcdn.apache.org is fast but drops old patches; archive.apache.org keeps all but is throttled.
    { { curl -fsSL https://dlcdn.apache.org/kafka/${KAFKA_VERSION}/kafka_${SCALA_VERSION}-${KAFKA_VERSION}.tgz -o /tmp/kafka.tgz || \
      curl -fsSL https://archive.apache.org/dist/kafka/${KAFKA_VERSION}/kafka_${SCALA_VERSION}-${KAFKA_VERSION}.tgz -o /tmp/kafka.tgz ; } && \
    tar -xzf /tmp/kafka.tgz -C /opt && \
    mv /opt/kafka_${SCALA_VERSION}-${KAFKA_VERSION} /opt/kafka && \
    rm -f /tmp/kafka.tgz ; } || exit 1

    # Compiled in and recorded on every data mutation; unset is recorded as unknown.
    if [ -n "{{ BOOM_GIT_SHA }}" ]; then export BOOM_GIT_SHA="{{ BOOM_GIT_SHA }}"; fi
    cd /app || exit 1
    cargo build --release --features gpu

    mkdir -p /app/bin
    cp /app/target/release/kafka_producer \
       /app/target/release/kafka_consumer \
       /app/target/release/scheduler \
       /app/target/release/task_worker \
       /app/target/release/linker \
       /app/bin/

Bootstrap: docker
From: nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04
Stage: final

%environment
    export PATH=/app:/opt/kafka/bin:$PATH
    export LD_LIBRARY_PATH=/opt/ort:/usr/local/cuda/lib64:$LD_LIBRARY_PATH
    export ORT_DYLIB_PATH=/opt/ort/libonnxruntime.so
    export BOOM_BOOMPY_PATH=/app/boompy
    export UV_PROJECT_ENVIRONMENT=/app/boompy/.venv
    # The SIF is read-only: run the environment synced at build time as-is
    export UV_NO_SYNC=1
    # Optional overrides
    export BOOM_DATABASE__HOST=localhost

%files
    data/models /app/data/models
    data/ls_footprint_moc.fits /app/data/ls_footprint_moc.fits
    boompy /app/boompy

%files from build
    /app/bin/kafka_producer /app/kafka_producer
    /app/bin/kafka_consumer /app/kafka_consumer
    /app/bin/scheduler /app/scheduler
    /app/bin/task_worker /app/task_worker
    /app/bin/linker /app/linker
    /opt/ort /opt/
    /opt/kafka /opt/

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && \
    apt-get install -y --no-install-recommends \
      ca-certificates curl bash libsasl2-2 libcfitsio10t64 default-jre-headless python3 && \
    apt-get autoremove -y && apt-get clean && rm -rf /var/lib/apt/lists/*

    # boompy fetches archival catalogs for the task worker, from the committed lockfile
    UV_VERSION=0.10.0
    curl -LsSf https://astral.sh/uv/${UV_VERSION}/install.sh | env UV_UNMANAGED_INSTALL=/usr/local/bin sh || exit 1
    rm -rf /app/boompy/.venv
    export UV_PROJECT_ENVIRONMENT=/app/boompy/.venv
    uv sync --project /app/boompy --frozen --no-dev --no-cache || exit 1
    mkdir -p /app/data/catalogs
